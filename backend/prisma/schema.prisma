  password_changed_at                                         DateTime?               @db.DateTime
  must_change_password                                        Boolean                 @default(false, map: "DF__users__must_chan__73BA3083")
  is_approved                                                 Boolean                 @default(false, map: "DF__users__is_approv__74AE54BC")
  approved_by                                                 Int?
  approved_at                                                 DateTime?               @db.DateTime
  creation_type                                               String                  @default("SELF_REGISTER", map: "DF__users__creation___75A278F5") @db.VarChar(50)
  last_password_reset_request_at                              DateTime?               @db.DateTime
  password_reset_token                                        String?                 @db.VarChar(255)
  password_reset_code                                         String?                 @db.VarChar(6)
  password_reset_expiry                                       DateTime?               @db.DateTime
  last_terms_accepted                                         DateTime?               @db.DateTime
  terms_version                                               String?                 @db.VarChar(20)
  recovery_email                                              String?                 @db.VarChar(255)
  temporary_account                                           Boolean                 @default(false, map: "DF__users__temporary__7B5B524B")
  account_expiry                                              DateTime?               @db.DateTime
  is_deleted                                                  Boolean                 @default(false, map: "DF__users__is_delete__7C4F7684")
  deleted_at                                                  DateTime?               @db.DateTime
  created_at                                                  DateTime                @default(now(), map: "DF__users__created_a__76969D2E") @db.DateTime
  create_by                                                   String?                 @db.NChar(20)
  updated_at                                                  DateTime                @default(now(), map: "DF__users__updated_a__778AC167") @db.DateTime
  update_by                                                   String?                 @db.NChar(20)
  remarks                                                     String?
  metadata                                                    String?                 @db.NVarChar(4000)
  auth_history                                                auth_history[]
  personal_access_tokens                                      personal_access_tokens[]
  notification_archives                                       notification_archives[]
  notification_settings                                       notification_settings?
  notifications                                               notifications[]
  password_history_password_history_changed_by_user_idTousers password_history[]      @relation("password_history_changed_by_user_idTousers")
  password_history_password_history_user_idTousers            password_history[]      @relation("password_history_user_idTousers")
  profile                                                     profile?
  request_logs                                                request_logs[]
  sessions                                                    session[]
  session_histories                                           session_history[]
  system_config                                               system_config[]
  two_factor_auth                                             two_factor_auth?
  user_roles_user_roles_assigned_by_idTousers                 user_roles[]            @relation("user_roles_assigned_by_idTousers")
  user_roles_user_roles_user_idTousers                        user_roles[]            @relation("user_roles_user_idTousers")
  users                                                       users?                  @relation("usersTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_approved_by")
  other_users                                                 users[]                 @relation("usersTousers")

  @@index([created_at], map: "IX_users_created_at")
  @@index([email, username], map: "IX_users_email_username")
  @@index([is_active, is_email_verified], map: "IX_users_is_active_is_email_verified")
  @@index([is_deleted, is_active], map: "IX_users_is_deleted_is_active")
}

model profile {
  id            Int       @id @default(autoincrement())
  user_id       Int       @unique
  first_name    String?   @db.NVarChar(100)
  last_name     String?   @db.NVarChar(100)
  display_name  String?   @db.NVarChar(100)
  avatar_url    String?   @db.NVarChar(255)
  phone_number  String?   @db.VarChar(20)
  department    String?   @db.VarChar(255)
  address       String?   @db.NVarChar(255)
  city          String?   @db.NVarChar(100)
  state         String?   @db.NVarChar(100)
  postal_code   String?   @db.VarChar(20)
  country       String?   @db.VarChar(2)
  date_of_birth DateTime? @db.Date
  gender        String?   @db.VarChar(1)
  bio           String?
  website       String?   @db.VarChar(255)
  created_at    DateTime  @default(now()) @db.DateTime
  updated_at    DateTime  @default(now()) @db.DateTime
  sub_district  String?   @db.VarChar(255)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "IX_profile_user_id")
}

model user_roles {
  user_id                                Int
  role_id                                String   @db.VarChar(50)
  assigned_by_id                         Int?
  remark                                 String?  @db.NVarChar(50)
  assigned_at                            DateTime @default(now()) @db.DateTime
  created_at                             DateTime @default(now()) @db.DateTime
  updated_at                             DateTime @default(now()) @db.DateTime
  users_user_roles_assigned_by_idTousers users?   @relation("user_roles_assigned_by_idTousers", fields: [assigned_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles                                  roles    @relation(fields: [role_id], references: [id], onDelete: Cascade)
  users_user_roles_user_idTousers        users    @relation("user_roles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([assigned_by_id], map: "IX_user_roles_assigned_by_id")
  @@index([role_id], map: "IX_user_roles_role_id")
  @@index([user_id], map: "IX_user_roles_user_id")
}

model two_factor_auth {
  id                    Int       @id @default(autoincrement())
  user_id               Int       @unique(map: "UQ__two_fact__B9BE370ED1174DE4")
  method                String    @db.VarChar(20)
  secret                String?   @db.VarChar(255)
  is_enabled            Boolean   @default(false, map: "DF__two_facto__is_en__66603565")
  created_at            DateTime  @default(now(), map: "DF__two_facto__creat__6754599E") @db.DateTime
  updated_at            DateTime  @default(now(), map: "DF__two_facto__updat__68487DD7") @db.DateTime
  backup_codes          String?
  backup_codes_used     String?
  recovery_method       String?   @db.VarChar(50)
  last_verified_at      DateTime? @db.DateTime
  verification_attempts Int       @default(0, map: "DF__two_facto__verif__693CA210")
  phone_number          String?   @db.VarChar(20)
  email_address         String?   @db.VarChar(255)
  device_name           String?   @db.VarChar(100)
  tfaSessionToken       String?   @db.NVarChar(255)
  users                 users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_two_factor_auth_user")
}

model password_history {
  id                                               Int      @id @default(autoincrement())
  user_id                                          Int
  password_hash                                    String   @db.VarChar(255)
  created_at                                       DateTime @default(now(), map: "DF__password___creat__440B1D61") @db.DateTime
  changed_by_user_id                               Int?
  change_reason                                    String?  @db.VarChar(100)
  ip_address                                       String?  @db.VarChar(50)
  user_agent                                       String?  @db.VarChar(255)
  users_password_history_changed_by_user_idTousers users?   @relation("password_history_changed_by_user_idTousers", fields: [changed_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_password_history_changed_by")
  users_password_history_user_idTousers            users    @relation("password_history_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_password_history_user")

  @@index([user_id, created_at], map: "IX_password_history_user_id_created_at")
}

model auth_history {
  id               Int       @id @default(autoincrement())
  user_id          Int?
  username         String    @db.VarChar(100)
  auth_type        String    @db.VarChar(20)
  auth_status      String    @db.VarChar(20)
  failure_reason   String?   @db.VarChar(100)
  ip_address       String?   @db.VarChar(45)
  user_agent       String?   @db.VarChar(255)
  device_info      String?   @db.VarChar(255)
  browser          String?   @db.VarChar(100)
  os               String?   @db.VarChar(100)
  location         String?   @db.VarChar(255)
  auth_source      String?   @db.VarChar(50)
  session_id       Int?
  two_factor_used  Boolean   @default(false)
  remember_me      Boolean   @default(false)
  logout_time      DateTime? @db.DateTime
  session_duration Int?
  additional_data  String?
  created_at       DateTime  @default(now()) @db.DateTime
  users            users?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at], map: "IX_auth_history_user_created")
  @@index([auth_type, auth_status, created_at], map: "IX_auth_history_type_status_created")
  @@index([ip_address], map: "IX_auth_history_ip")
  @@index([username, auth_status], map: "IX_auth_history_username_status")
  @@index([created_at], map: "IX_auth_history_created")
}

model session {
  id                Int       @id @default(autoincrement())
  user_id           Int
  access_token      String    @db.NVarChar(512)
  refresh_token     String?   @db.NVarChar(512)
  ip_address        String?   @db.NVarChar(45)
  user_agent        String?   @db.NVarChar(255)
  device_info       String?   @db.NVarChar(255)
  location          String?   @db.NVarChar(4000)
  login_source      String?   @db.NVarChar(50)
  session_type      String?   @db.NVarChar(50)
  is_active         Boolean?  @default(true, map: "DF__Session__is_acti__5812160E")
  revocation_reason String?   @db.NVarChar(255)
  created_at        DateTime? @default(now(), map: "DF__Session__created__59063A47") @db.DateTime
  updated_at        DateTime? @db.DateTime
  expires_at        DateTime  @db.DateTime
  last_used_at      DateTime? @db.DateTime
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([access_token], map: "IDX_Session_AccessToken")
  @@index([is_active], map: "IDX_Session_IsActive")
  @@index([user_id], map: "IDX_Session_User")
}

model session_history {
  id                  Int       @id @default(autoincrement())
  user_id             Int
  access_token        String    @db.NVarChar(512)
  refresh_token       String?   @db.NVarChar(512)
  ip_address          String?   @db.NVarChar(45)
  user_agent          String?   @db.NVarChar(255)
  device_info         String?   @db.NVarChar(255)
  location            String?   @db.NVarChar(4000)
  login_source        String?   @db.NVarChar(50)
  session_type        String?   @db.NVarChar(50)
  is_active           Boolean?  @default(true, map: "DF__SessionHi__is_ac__5AEE82B9")
  status              String    @db.NVarChar(50)
  revocation_reason   String?   @db.NVarChar(255)
  created_at          DateTime? @db.DateTime
  expired_at          DateTime? @db.DateTime
  last_used_at        DateTime? @db.DateTime
  moved_to_history_at DateTime? @default(now(), map: "DF__SessionHi__moved__5BE2A6F2") @db.DateTime
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expired_at], map: "IDX_SessionHistory_ExpiredAt")
  @@index([moved_to_history_at], map: "IDX_SessionHistory_MovedAt")
  @@index([status], map: "IDX_SessionHistory_Status")
  @@index([user_id], map: "IDX_SessionHistory_User")
}

model roles {
  id                                                  String                   @id @db.VarChar(50)
  name                                                String                   @unique @db.VarChar(100)
  priority                                            Int?                     @default(0, map: "DF_roles_priority")
  description                                         String?                  @db.VarChar(255)
  created_at                                          DateTime                 @default(now()) @db.DateTime
  updated_at                                          DateTime                 @default(now()) @db.DateTime
  api_route_requirements                              api_route_requirements[]
  role_hierarchy_role_hierarchy_child_role_idToroles  role_hierarchy[]         @relation("role_hierarchy_child_role_idToroles")
  role_hierarchy_role_hierarchy_parent_role_idToroles role_hierarchy[]         @relation("role_hierarchy_parent_role_idToroles")
  role_permissions                                    role_permissions[]
  user_roles                                          user_roles[]
}

model role_hierarchy {
  parent_role_id                             String   @db.VarChar(50)
  child_role_id                              String   @db.VarChar(50)
  created_at                                 DateTime @default(now()) @db.DateTime
  roles_role_hierarchy_child_role_idToroles  roles    @relation("role_hierarchy_child_role_idToroles", fields: [child_role_id], references: [id], onDelete: Cascade)
  roles_role_hierarchy_parent_role_idToroles roles    @relation("role_hierarchy_parent_role_idToroles", fields: [parent_role_id], references: [id], onUpdate: NoAction)

  @@id([parent_role_id, child_role_id])
  @@index([child_role_id], map: "IX_role_hierarchy_child_role_id")
  @@index([parent_role_id], map: "IX_role_hierarchy_parent_role_id")
}

model role_permissions {
  role_id       String      @db.VarChar(50)
  permission_id String      @db.VarChar(50)
  created_at    DateTime    @default(now()) @db.DateTime
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id], map: "IX_role_permissions_permission_id")
  @@index([role_id], map: "IX_role_permissions_role_id")
}

model permissions {
  id                     String                   @id @db.VarChar(50)
  name                   String                   @unique @db.VarChar(100)
  description            String?                  @db.VarChar(255)
  resource               String                   @db.VarChar(50)
  action                 String                   @db.VarChar(50)
  created_at             DateTime                 @default(now()) @db.DateTime
  updated_at             DateTime                 @default(now()) @db.DateTime
  api_route_requirements api_route_requirements[]
  menu_items             menu_items[]
  role_permissions       role_permissions[]

  @@unique([resource, action], map: "UQ_permissions_resource_action")
  @@index([resource, action], map: "IX_permissions_resource_action")
}

model api_route_requirements {
  id            Int          @id @default(autoincrement())
  method        String       @db.VarChar(10)
  path          String       @db.NVarChar(255)
  role_id       String?      @db.VarChar(50)
  permission_id String?      @db.VarChar(50)
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.DateTime
  updated_at    DateTime     @default(now()) @db.DateTime
  permissions   permissions? @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles         roles?       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([method, path], map: "UQ_api_route_requirements_method_path")
  @@index([permission_id], map: "IX_api_route_requirements_permission_id")
  @@index([role_id], map: "IX_api_route_requirements_role_id")
  @@index([method, path, is_active], map: "IX_api_route_requirements_lookup")
}

model notifications {
  id                 Int                  @id @default(autoincrement())
  user_id            Int?
  title              String               @db.NVarChar(255)
  message            String
  type               String               @db.VarChar(20)
  priority           String               @default("NORMAL") @db.VarChar(10)
  is_read            Boolean              @default(false)
  created_at         DateTime             @default(now()) @db.DateTime
  users              users?               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, is_read, created_at])
}

model notification_archives {
  id                  Int       @id @default(autoincrement())
  original_id         Int
  user_id             Int?
  title               String    @db.NVarChar(255)
  message             String
  type                String    @db.VarChar(20)
  priority            String    @db.VarChar(10)
  is_read             Boolean
  original_created_at DateTime  @db.DateTime
  read_at             DateTime? @db.DateTime
  archived_at         DateTime  @default(now()) @db.DateTime
  archived_reason     String    @default("AUTO_CLEANUP") @db.VarChar(50)
  users               users?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, original_created_at])
  @@index([archived_at])
  @@index([original_id])
  @@index([type, archived_at])
}

model notification_settings {
  id                     Int      @id @default(autoincrement())
  user_id                Int      @unique
  login_notifications    Boolean  @default(true)
  security_notifications Boolean  @default(true)
  system_notifications   Boolean  @default(false)
  email_notifications    Boolean  @default(true)
  browser_notifications  Boolean  @default(true)
  created_at             DateTime @default(now()) @db.DateTime
  updated_at             DateTime @default(now()) @db.DateTime
  users                  users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model request_logs {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  method        String
  url           String
  path          String
  query_params  String?
  user_id       Int?
  username      String?
  ip_address    String
  user_agent    String?
  browser       String?
  os            String?
  device_type   String?
  platform      String?
  status_code   Int?
  response_time Int?
  request_size  Int?
  response_size Int?
  error_message String?
  error_stack   String?
  referer       String?
  session_id    String?
  user          users?   @relation(fields: [user_id], references: [id])

  @@index([timestamp])
  @@index([user_id])
  @@index([path])
  @@index([status_code])
  @@index([ip_address])
  @@index([method])
  @@map("request_logs")
}

model menu_items {
