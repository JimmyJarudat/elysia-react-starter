  username                                                    String                  @unique(map: "UQ__users__F3DBC572C270D0BA") @db.VarChar(100)
  email                                                       String                  @unique(map: "UQ__users__AB6E6164D7D9F4FE") @db.VarChar(255)
  group_name                                                  String?                 @db.NChar(100)
  password                                                    String                  @db.VarChar(255)
  is_active                                                   Boolean                 @default(true, map: "DF__users__is_active__70DDC3D8")
  is_email_verified                                           Boolean                 @default(false, map: "DF__users__is_email___71D1E811")
  email_verified_at                                           DateTime?               @db.DateTime
  failed_login_attempts                                       Int                     @default(0, map: "DF__users__failed_lo__72C60C4A")
  locked_until                                                DateTime?               @db.DateTime
