@@ -3,6 +3,7 @@
 var SMB2Message = require('../tools/smb2-message')
   , message = require('../tools/message')
   , ntlm = require('ntlm')
+  , crypto = require('crypto')
   ;
 
 
@@ -29,4 +30,12 @@ module.exports = message({
 
   }
 
+, onSuccess:function(connection){
+    // NTLMv1 session base key (no key exchange) = MD4(MD4(UCS2(password)))
+    // used as the SMB2 signing key for HMAC-SHA256 message signing
+    var ntHash = ntlm.smbhash.nthashbuf(connection.password);
+    connection.sessionKey = crypto.createHash('md4').update(ntHash).digest();
+    connection.signingEnabled = true;
+  }
+
 });
